{
  "name": "aon-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Discord AI assistant for Age of Nations",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "better-sqlite3": "^12.4.1",
    "discord.js": "^14.24.2",
    "dotenv": "^17.2.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
